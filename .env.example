# PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/eecbookhub
DB_USERNAME=postgres
DB_PASSWORD=change-me

# SMTP sender for real OTP emails
MAIL_USERNAME=your-app-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM=your-app-email@gmail.com

# Direct UPI payments do not require a gateway API key. Providers save their UPI ID in Profile.

# Production
COOKIE_SECURE=true
JPA_DDL_AUTO=update
